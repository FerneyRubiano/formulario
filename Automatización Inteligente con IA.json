    {
      "parameters": {
        "jsCode": "// 1. Acceder a los datos originales del formulario\nconst webhookData = $('Webhook').item.json.body;\n\n// 2. Acceder a la respuesta que ya tienes funcionando de la IA\nconst iaResponse = $input.first().json;\n\n// 3. Generar número de ticket aleatorio\nconst ticket = 'TK-' + Math.floor(10000 + Math.random() * 90000);\n\n// 4. Lógica de tiempos basada en la prioridad que calculó la IA\nconst prioridadFinal = iaResponse.prioridad_ia || webhookData.prioridad || \"Baja\";\nlet tiempoEstimado = '';\n\nswitch (prioridadFinal) {\n  case 'Alta':\n    tiempoEstimado = '2 horas';\n    break;\n  case 'Media':\n    tiempoEstimado = '8 horas';\n    break;\n  case 'Baja':\n    tiempoEstimado = '24 horas';\n    break;\n  default:\n    tiempoEstimado = 'Sin definir';\n}\n\n// 5. Crear el mensaje final para el correo y la respuesta del navegador\nconst mensaje = `Hola ${webhookData.nombre || 'Usuario'},\n\nTu solicitud fue registrada exitosamente.\n\nTicket: ${ticket}\nResumen IA: ${iaResponse.resumen}\nPrioridad calculada: ${prioridadFinal}\nTiempo estimado: ${tiempoEstimado}\n\nEquipo de Tecnología`;\n\n// 6. Retornar los datos limpios para los siguientes nodos\nreturn [\n  {\n    json: {\n      nombre: webhookData.nombre,\n      correo: webhookData.correo,\n      ticket: ticket,\n      prioridad: prioridadFinal,\n      resumen: iaResponse.resumen,\n      tiempoEstimado: tiempoEstimado,\n      mensaje: mensaje\n    }\n  }\n];"
      },
